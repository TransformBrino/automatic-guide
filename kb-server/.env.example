# ============================================
# 传化具身智能 · 员工知识库系统 - 环境变量模板
# ============================================
# 使用方式：复制本文件为 .env 并填入真实值
# 注意：.env 文件已加入 .gitignore，不会提交版本控制

# ---------- 数据库配置 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=kb_user
DB_PASSWORD=change_me
DB_NAME=kb_db

# ---------- AI API 配置 ----------
# OpenAI 兼容的 Chat Completions 端点
AI_API_URL=https://api.example.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o
# 联网搜索（DeepSeek 支持 enable_web_search 参数）
ENABLE_WEB_SEARCH=false
# 深度思考（DeepSeek 支持 thinking/reasoning 模式）
ENABLE_THINKING=false

# ---------- JWT 配置 ----------
# 请替换为足够长的随机字符串（建议 32 字符以上）
JWT_SECRET=change_me_to_random_string

# ---------- 服务配置 ----------
PORT=3000
# 会话超时时间（分钟），无活动超过此值自动清理
SESSION_TIMEOUT_MINUTES=30
